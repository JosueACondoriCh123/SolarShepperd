ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://solarshepherd:solarshepherd@db:5432/solarshepherd
REDIS_URL=redis://redis:6379/0
API_ADMIN_TOKEN=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173

# Use `supabase` in staging/production. Development mode creates a local
# owner principal only when ENVIRONMENT is not production.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SYSTEM_OWNER_EMAILS=
TURNSTILE_SITE_KEY=
RESEND_API_KEY=
EMAIL_FROM=SolarShepherd <no-reply@example.com>
SAMPLE_EVIDENCE_BUCKET=sample-evidence
REPORTS_BUCKET=reports
SIGNED_URL_TTL_SECONDS=300
LOCAL_STORAGE_PATH=/data/operational

# Conduit credentials must be rotated and supplied at runtime only.
CONDUIT_API_URL=https://conduit.jhubafrica.com/data.php
CONDUIT_API_KEY=
CONDUIT_EMAIL=
# Verified JKUAT Conduit mapping. Rain-gauge and SI1145 light channels stay
# unmapped until their units/calibration are confirmed.
CONDUIT_FIELD_MAP_JSON={"observed_at":"ts","temperature_c":"st1","relative_humidity_pct":"sh1","pressure_hpa":"bp1","precipitation_mm":"rgt","precipitation_increment_mm":"rg","precipitation_prior_day_mm":"rgp","wind_speed_m_s":"ws","wind_direction_deg":"wd","wind_gust_m_s":"wg","heat_index_c":"hi","wet_bulb_temperature_c":"wbt","wet_bulb_globe_temperature_c":"wbgt","visible_light_count":"sv1","infrared_light_count":"si1"}
CONDUIT_STATION_ID=jkuat-conduit

PILOT_NAME=JKUAT
PILOT_LAT=-1.1018
PILOT_LON=37.0144
PILOT_RADIUS_KM=10
PILOT_TIMEZONE=Africa/Nairobi
H3_RESOLUTION=9
STAC_MAX_CLOUD_PERCENT=30
STAC_LOOKBACK_DAYS=60
OSM_OVERPASS_URL=https://lz4.overpass-api.de/api/interpreter
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
AVIATION_WEATHER_API_URL=https://aviationweather.gov/api/data/metar
FORECAST_HOURS=72

# Frontend (use a separate frontend/.env.local when not running Compose)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AUTH_MODE=development
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
